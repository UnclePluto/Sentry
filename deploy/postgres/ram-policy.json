{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:DeleteObject",
        "oss:AbortMultipartUpload",
        "oss:ListParts"
      ],
      "Resource": [
        "acs:oss:*:*:floatnoise-wh/sentry/postgresql/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects"
      ],
      "Resource": [
        "acs:oss:*:*:floatnoise-wh"
      ],
      "Condition": {
        "StringLike": {
          "oss:Prefix": [
            "sentry/postgresql/*"
          ]
        }
      }
    }
  ]
}
