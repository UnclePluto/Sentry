# 私有暂存目录；默认项目内 data。原 Excel 不纳入长期备份。
SENTRY_DATA_DIR=./data
# 本机开发使用隔离 PostgreSQL；正式部署用 DATABASE_URL_FILE 注入独立运行身份。
DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:5432/sentry
# 内部 API 默认仅监听回环地址，不直接暴露到局域网。
# 设为 1 可阻止首次启动创建模拟数据，不影响已存在的演示数据。
SENTRY_NO_DEMO=0

# 后台浏览器写入来源，院内 HTTPS 部署时替换为实际管理端域名。
SENTRY_TRUSTED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
# 本机 HTTP 为 0；HTTPS 部署改为 1。
SENTRY_SECURE_COOKIE=0
# 可选：仅首次创建超管时使用，留空则随机生成。不要提交真实密码。
# SENTRY_BOOTSTRAP_PASSWORD=

# ECS 备份只使用绑定角色的临时凭据，不配置主账户 AccessKey。
SENTRY_OSS_BUCKET=floatnoise-wh
SENTRY_OSS_ENDPOINT=oss-cn-wuhan-lr.aliyuncs.com
SENTRY_BACKUP_ENV=production
# 每个独立数据库必须设置不同标识，避免混用备份链。
# SENTRY_BACKUP_INSTANCE=
